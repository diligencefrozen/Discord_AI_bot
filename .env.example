# Never commit actual keys. Runtime reads DISCORD_TOKEN (not BOT_TOKEN aliases).
DISCORD_TOKEN=

# All text question paths use Gemini; no automatic retry/provider fallback.
TEXT_AI_PROVIDER=gemini
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Operational hotfix recommendation; code default remains 30 when unset.
# This is an httpx per-phase timeout, not an absolute end-to-end deadline.
GEMINI_TIMEOUT_SECONDS=60
# Local in-memory safeguards, not guaranteed Google project quotas.
GEMINI_RPM_LIMIT=15
GEMINI_RPD_LIMIT=500
GEMINI_USER_COOLDOWN_SECONDS=10

# V6: audit remote commands at startup; auto repairs missing/obsolete/restricted
# commands only after checking the complete local list and remote ownership.
# 1 = force safe publish, 0 = remote audit only (no writes), unset = auto.
SLASH_SYNC_ON_STARTUP=auto

# First typing event starts one timer; later events do not postpone it.
# Finite 0.1..1.5 seconds; invalid values fall back to 1.3.
TYPING_INTRO_DELAY_SECONDS=1.3

# Images always use AI Horde. AI_PROVIDER/AI_BACKEND are legacy settings only.
AI_PROVIDER=aihorde
# Optional; blank uses the anonymous Horde key.
# Key precedence: AI_HORDE_API_KEY > HORDE_API_KEY > AIHORDE_API_KEY.
HORDE_API_KEY=
HORDE_BASE_URL=https://aihorde.net/api
# HORDE_IMAGE_MODEL wins over legacy AIHORDE_IMAGE_MODEL.
HORDE_IMAGE_MODEL=
HORDE_TIMEOUT_SECONDS=140
HORDE_POLL_INTERVAL_SECONDS=2
HORDE_IMAGE_HOSTS=aihorde.net,stablehorde.net
HORDE_MAX_IMAGE_BYTES=8000000
IMAGE_CONCURRENCY_LIMIT=2
IMAGE_REQUEST_COOLDOWN=20

# Old HF secrets may remain in hosting configuration; these AI paths do not use them.
HF_TOKEN=
HF_IMG_TOKEN=

# Mounted persistent volume recommended; otherwise historical CWD files.
DATA_DIR=
# Backward-compatible alias; DATA_DIR takes precedence.
STATE_DIR=

# 파딱 (파란 딱지): union both settings, deduplicate exact integer IDs.
# Keep the existing account AND add the new account in the runtime environment.
# Any malformed nonempty setting disables all 파딱 exceptions; owner still allowed.
SPECIAL_ADMIN_USER_ID=855749166764654653
SPECIAL_ADMIN_USER_IDS=855749166764654653,491239880005910538
# Optional comma-separated guild IDs; applies to 파딱, owners retain access.
SPECIAL_ADMIN_GUILD_IDS=

# Optional moderation metadata channel in the same guild (no message/reason body).
# In-memory recent history is bounded and resets on restart.
MOD_LOG_CHANNEL_ID=

# Reuse the existing single PUBLIC log destination per guild from LOG_ROUTES.
# Destination readers must be a subset of source readers, including role/member
# overrides. Private/unknown sources use anonymous restricted receipts only;
# public verified sources send full cards. No new channel.
# Only exact 1 enables each flag; malformed flags disable the feature.
DELETION_PUBLIC_LOG_ENABLED=1
DELETION_PUBLIC_LOG_INCLUDE_CONTENT=1
DELETION_LOG_ALL_GUILD_CHANNELS=1
# /관리 reports these parsed values; editing this example does not change Northflank.
# MESSAGE_CONTENT must also be enabled in Discord Developer Portal.
# Optional exact comma-separated source IDs; malformed lists grant no extras.
DELETION_LOG_EXTRA_SOURCE_CHANNEL_IDS=
# Legacy DELETION_LOG_INCLUDE_CONTENT/private/trusted-role settings are ignored.

# Online raw/cached edits and a separate bounded history scan share one policy.
# A 72-hour interval needs >=96-hour created-time lookback for overlap.
EDIT_MODERATION_ENABLED=1
EDIT_MODERATION_SCAN_ENABLED=1
EDIT_MODERATION_SCAN_INTERVAL_HOURS=72
EDIT_MODERATION_SCAN_LOOKBACK_HOURS=96
EDIT_MODERATION_SCAN_MAX_MESSAGES_PER_CHANNEL=2000
EDIT_MODERATION_SCAN_MAX_MESSAGES_TOTAL=20000
EDIT_MODERATION_SCAN_CONCURRENCY=1
EDIT_MODERATION_SCAN_STARTUP_DELAY_SECONDS=45
