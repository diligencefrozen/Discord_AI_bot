# Runtime settings and secrets (never commit the real values)
DISCORD_TOKEN=
# Free AI Horde is the default. Set AI_PROVIDER=huggingface only when
# intentionally using the preserved Hugging Face integration.
AI_PROVIDER=aihorde
# Optional AI Horde account key. The anonymous key is used when empty.
HORDE_API_KEY=
HORDE_BASE_URL=https://aihorde.net/api
# Optional model pinning; leave blank to use Horde's available workers.
HORDE_TEXT_MODEL=
HORDE_IMAGE_MODEL=
HF_TOKEN=
HF_IMG_TOKEN=
# Optional Northflank persistent-volume directory. Leave unset to preserve
# the historical working-directory state files.
DATA_DIR=
# STATE_DIR is accepted as a backwards-compatible alias for DATA_DIR.
STATE_DIR=
# v6 administrator policy. The special account is disabled if this is empty
# or malformed; the Discord server owner remains the only allowed manager.
SPECIAL_ADMIN_USER_ID=855749166764654653

# Optional comma-separated guild IDs to scope the special account.
SPECIAL_ADMIN_GUILD_IDS=
